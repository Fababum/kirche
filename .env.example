# Kopiere diese Datei nach ".env" und passe die Werte an, bevor du
# "docker compose up -d --build" ausführst.

# Port, unter dem die Webseite auf dem Host erreichbar ist.
APP_PORT=4001

# Wird NUR beim allerersten Start verwendet, um automatisch einen
# Admin-Zugang für /admin anzulegen. Das Passwort wird sofort als bcrypt-Hash
# in der Datenbank gespeichert. WICHTIG (Sicherheit): Danach diese beiden
# Zeilen wieder entfernen/leer lassen - sie werden nicht mehr gebraucht und
# sollten nicht dauerhaft im Klartext hier liegen bleiben. Der Server warnt
# beim Start in den Logs, falls sie trotzdem noch gesetzt sind.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=bitte-aendern

# Geheimer Schlüssel zum Signieren der Admin-Login-Sitzungen.
# WICHTIG: In Produktion einen langen, zufälligen Wert einsetzen!
# Erzeugen z.B. mit: openssl rand -hex 32
JWT_SECRET=bitte-aendern-langer-zufallswert

# Herkunft des Frontends (wichtig für CORS). Lokal meist der Vite-Dev-Server.
CLIENT_ORIGIN=http://localhost:5173

# E-Mail-Benachrichtigungen (via Resend, https://resend.com - kostenloser Plan
# reicht locker aus). Ohne RESEND_API_KEY können neue Reservationen nicht
# abgeschlossen werden, da die Verifikationsmail erforderlich ist.
#  1. Account auf resend.com erstellen
#  2. Absender-Domain osterweg-wyland.com bei Resend verifizieren
#  3. API-Key erzeugen und hier eintragen
RESEND_API_KEY=
# Absenderadresse, muss bei Resend verifiziert sein (Format: "Name <adresse>")
MAIL_FROM=Osterweg Wyland <noreply@osterweg-wyland.com>
# Einzelne öffentliche Basis-URL für Mail-Links, keine CORS-Liste.
PUBLIC_URL=https://osterweg-wyland.com
# Empfänger für verbindlich bestätigte Reservationen.
# Leer oder nicht gesetzt: sekretariat@kirche-wm.ch.
NOTIFY_EMAIL=sekretariat@kirche-wm.ch
# Optionale, betreute Antwortadresse: erst nach Bestätigung eintragen.
# Leer: kein Reply-To; Besucher werden auf die Website-Kontakte verwiesen.
MAIL_REPLY_TO=

# MapTiler API-Key für die Standortkarte (Info-Sektion). Kostenloser Account
# auf maptiler.com -> API Keys -> neuen Key erstellen. Wird ins Frontend-
# Bundle eingebacken (kein Server-Geheimnis) - beim Erstellen unter "Allowed
# HTTP Origins" die eigene(n) Domain(s) eintragen, damit der Key nicht von
# fremden Webseiten missbraucht werden kann.
VITE_MAPTILER_KEY=
